// Prisma schema —— 球衣跨境电商（开发执行文档 §5 数据模型 + §12 双店协同）
// 数据库：SQLite（K-S0-1，双店同机零外部依赖；将来多机部署迁 PostgreSQL 时：
//   - String 存 JSON 文本的字段改回 Json / String[]，状态字段改回 enum，金额改回 Decimal @db.Decimal(10, 2)）
// 价格一律以 USD 基准存储，展示层换算；避免多币种对账混乱。
// SQLite 限制（Prisma 5）：不支持 enum / String[] / Json / Decimal——
//   状态字段以 String 存原 enum 值域（值域见行内注释），数组与结构化数据以 JSON 文本存 String。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ---------------- 商品 ----------------

model Product {
  id              String   @id @default(cuid())
  sku             String   @unique
  slug            String   @unique
  titleKey        String? // i18n key（动态标题预留）
  titleEn         String
  season          String?
  teamId          String?
  league          String?
  /// 值域（原 ProductType enum）：home | away | third | gk | training | retro
  type            String   @default("home")
  /// 值域（原 ProductVersion enum）：fan | player | kids
  version         String   @default("fan")
  basePriceUsd    Float // USD 两位小数（应用层格式化；迁 PG 改回 Decimal(10,2)）
  comparePriceUsd Float?
  descriptionKey  String?
  /// JSON 文本：图片 URL 数组（迁 PG 改回 String[]）
  images          String   @default("[]")
  /// 值域（原 ProductStatus enum）：draft | active | archived（archived=软删除可恢复，同步 tombstone 落这里）
  status          String   @default("draft")
  /// JSON 文本：迁移/导入时原对象保真（未知短字段全存这里，K-S0-4 读路径以库为准）
  ext             String?
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id])
  collections     CollectionProduct[]
  variants        Variant[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([season])
  @@index([teamId])
}

model Variant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String // S / M / L / XL / 2XL / 3XL / 4XL
  sku            String  @unique
  stock          Int     @default(0)
  priceAdjustUsd Float   @default(0)

  @@unique([productId, size])
}

// ---------------- 分类 ----------------

model Category {
  id       String              @id @default(cuid())
  slug     String              @unique
  nameKey  String?
  nameEn   String
  /// 值域（原 CategoryType enum）：national | club | season | retro | kids | outerwear | shorts | other
  type     String              @default("other")
  parentId String?
  parent   Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]          @relation("CategoryTree")
  sort     Int                 @default(0)
  /// JSON 文本：主站同步分类的溢出字段（teamGroup/image 等，K-S2-5）
  ext      String?
  products CollectionProduct[]
}

// 多对多：商品 ↔ 分类（跨集合商品合并归属）
model CollectionProduct {
  categoryId String
  productId  String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId])
  @@index([productId])
}

// ---------------- 客户 CRM（N9） ----------------

model Customer {
  id                  String         @id @default(cuid())
  email               String?        @unique
  name                String?
  isRegistered        Boolean        @default(false)
  country             String?
  currency            String         @default("USD")
  source              String? // 来源渠道
  firstSeenAt         DateTime       @default(now())
  lastSeenAt          DateTime       @default(now())
  orderCount          Int            @default(0)
  repeatPurchaseCount Int            @default(0) // 回购次数
  ltvUsd              Float          @default(0)
  hasContact          Boolean        @default(false) // 是否留联系方式
  contactType         String? // email / whatsapp / phone
  /// JSON 文本：标签数组（迁 PG 改回 String[]）
  tags                String         @default("[]")
  events              CustomerEvent[]
  followUps           FollowUp[]
  orders              Order[]
  createdAt           DateTime       @default(now())

  @@index([lastSeenAt])
  @@index([orderCount])
}

model CustomerEvent {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId  String // 访客 ID（前端 localStorage）
  /// 值域（原 CustomerEventType enum）：view_product | add_to_cart | remove_from_cart | checkout_start | order | contact | return_visit
  type       String
  productId  String?
  durationMs Int? // 停留时长
  /// JSON 文本（迁 PG 改回 Json）
  meta       String?
  createdAt  DateTime  @default(now())

  @@index([sessionId])
  @@index([type])
  @@index([createdAt])
}

model FollowUp {
  id          String   @id @default(cuid())
  customerId  String?
  /// 原文件客户键（email），CRM 宽松关联；customerId 暂空（Customer 表由 CRM 运行时派生）
  customerKey String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// 值域（原 FollowUpStatus enum）：pending | contacted | converted | lost | not_interested
  status     String   @default("pending")
  nextAt     DateTime?
  owner      String?
  note       String?
  /// JSON 文本：时间线 [{time,action,note}]（迁 PG 改回 Json）
  history    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([nextAt])
  @@index([customerKey])
}

// ---------------- 订单与物流（N2 / N8） ----------------

model Order {
  id                String    @id @default(cuid())
  orderNo           String    @unique
  customerId        String?
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email             String
  /// JSON 文本：[{handle,title,priceUsd,size,qty,image}]（迁 PG 改回 Json）
  items             String
  subtotalUsd       Float
  discountUsd       Float     @default(0)
  shippingUsd       Float     @default(0)
  totalUsd          Float
  currency          String    @default("USD") // 下单时展示币种快照
  /// 值域（原 PaymentStatus enum）：pending | paid | failed | refunded
  paymentStatus     String    @default("pending")
  /// 值域（原 FulfillmentStatus enum）：unfulfilled | packing | shipped | in_transit | delivered | exception
  fulfillmentStatus String    @default("unfulfilled")
  phone             String?
  /// 支付方式：cod | online_stripe | online_paypal | transfer（运行时值域，见 CheckoutClient）
  paymentMethod     String?
  /// JSON 文本：{name,address,city,country,zip}（迁 PG 改回 Json）
  address           String?
  /// JSON 文本：迁移/运行时溢出字段（shipment 内嵌运单、OMS 推送结果、款项明细等），往返无损
  ext               String?
  shipments         Shipment[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([email])
  @@index([createdAt])
}

model Shipment {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier     String? // dhl / fedex / ups / yunexpress / 4px ...
  trackingNo  String?
  /// 值域（原 ShipmentStatus enum）：pending | in_transit | delivered | exception
  status      String    @default("pending")
  /// JSON 文本：轨迹 [{time,location,description}]（迁 PG 改回 Json）
  events      String?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([trackingNo])
}

// ---------------- 批量导入（N3） ----------------

model ImportBatch {
  id           String   @id @default(cuid())
  folderName   String
  fileCount    Int      @default(0)
  productCount Int      @default(0)
  /// 值域（原 ImportBatchStatus enum）：parsed | preview | imported | failed
  status       String   @default("parsed")
  log          String?
  createdBy    String?
  products     Product[]
  createdAt    DateTime @default(now())
}

// ---------------- 后台权限（N6） ----------------

model AdminUser {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  name           String?
  /// 值域（原 AdminRole enum）：owner | operator | viewer
  role           String     @default("operator")
  /// 自定义角色名（仅标识用，不影响权限）
  roleName       String?
  /// JSON 文本：权限 key 数组（lib/perm-client.ts 集中定义）；owner 恒为全部（迁 PG 改回 String[]）
  permissions    String     @default("[]")
  lastLoginAt    DateTime?
  /// 最后修改密码时间
  lastPasswordAt DateTime?
  createdAt      DateTime   @default(now())
  auditLogs      AuditLog[]
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  target      String?
  /// JSON 文本（迁 PG 改回 Json）
  meta        String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

// ---------------- 汇率（N1） ----------------

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String   @default("USD")
  quote     String
  rate      Float
  updatedAt DateTime @default(now())

  @@unique([base, quote])
}

// ---------------- 前台客户账号与媒体（K-S0-2 数据迁移） ----------------

/// 前台注册用户（原 data/users.jsonl）；后台管理员在 AdminUser，两套账号互不相通
model User {
  id           String    @id // 原 u_* id 保留
  email        String    @unique
  name         String?
  passwordHash String
  phone        String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
  /// JSON 文本：溢出字段（whatsapp、addresses、address 等），往返无损
  ext          String?
  orders       Order[]
}

/// 媒体登记（原 data/admin/media.json）：后台本地上传与导入图的统一索引
model MediaEntry {
  id         String   @id @default(cuid())
  url        String   @unique
  name       String
  size       Int      @default(0)
  source     String? // contact | hero | product | media | imports ...
  uploadedAt DateTime @default(now())
}

// ---------------- 双店同步（K 系列，开发执行文档 §12） ----------------

/// 同步游标：本店已消费到主站 outbox（catalog_changes.seq）的位置
model SyncCursor {
  id        String   @id @default(cuid())
  source    String   @unique // 同步源标识，如 "jerseyshelf"
  cursor    Int      @default(0) // 已消费的最后 seq
  updatedAt DateTime @updatedAt
}

/// 本店覆盖：同一商品在本店的差异化展示；主数据来自主站同步，永不回写主站
model CatalogOverride {
  id              String   @id @default(cuid())
  productSlug     String   @unique // 对齐主站商品 slug
  priceFactor     Float? // 价格系数（空 = 用主站基准价）
  priceUsd        Float? // 直接指定本店价（优先于 priceFactor）
  titleEn         String? // 本店标题文案
  /// 本店上下架：active | hidden（空 = 跟随主站状态）
  status          String?
  customizationOn Boolean  @default(true) // 本店是否开放定制
  note            String?
  updatedAt       DateTime @updatedAt
}
